{
  "type": "module",
  "name": "pacman",
  "version": "1.0.0",
  "description": "Everyone's favorite arcade game",
  "main": "pacman.js",
  "directories": {
    "doc": "doc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masonicGIT/pacman.git"
  },
  "keywords": [
    "pacman"
  ],
  "author": "Shaun Williams, Mason Borda",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/masonicGIT/pacman/issues"
  },
  "homepage": "https://github.com/masonicGIT/pacman#readme",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "smoke:sepolia": "node scripts/smoke-sepolia.mjs",
    "e2e:sponsor": "node scripts/e2e-sponsor.mjs",
    "e2e:bundler": "node scripts/e2e-bundler.mjs",
    "sdk:bundle": "node scripts/bundle-minikit.mjs",
    "game:build": "node scripts/build-pacman.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "self:check": "node scripts/self-check.mjs",
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "contracts:compile": "npx hardhat compile",
    "contracts:test": "npx hardhat test",
    "contracts:deploy:sepolia": "npx hardhat run scripts/deploy-baseman-registry.cjs --network baseSepolia",
    "contracts:deploy:base": "npx hardhat run scripts/deploy-baseman-registry.cjs --network base",
    "contracts:verify": "npx hardhat run scripts/verify-baseman-registry.cjs",
    "contracts:verify:sepolia": "npx hardhat run scripts/verify-baseman-registry.cjs --network baseSepolia",
    "contracts:verify:base": "npx hardhat run scripts/verify-baseman-registry.cjs --network base",
    "contracts:set-authorizer": "npx hardhat run scripts/set-authorizer.cjs",
    "contracts:set-authorizer:sepolia": "npx hardhat run scripts/set-authorizer.cjs --network baseSepolia",
    "contracts:set-authorizer:base": "npx hardhat run scripts/set-authorizer.cjs --network base",
    "onchain:config": "node scripts/generate-onchain-config.mjs",
    "check:bundler": "node scripts/e2e-bundler.mjs",
    "check:sponsor": "node scripts/e2e-sponsor.mjs",
    "webhooks:setup": "node scripts/setup-secrets.mjs",
    "policy:check": "node scripts/check-policy.mjs",
    "docs:toc": "doctoc docs --github",
    "docs:dedup": "node scripts/dedup-md.mjs docs/Base_MiniApps_Docs.md",
    "docs:merge": "node scripts/merge-md.mjs docs/Base_MiniApps_Docs.md --inplace",
    "docs:toc:shallow": "doctoc docs --github --maxlevel 3",
    "docs:lint": "markdownlint \"docs/**/*.md\"",
    "docs:links": "node scripts/check-links.mjs",
    "docs:spell": "cspell \"docs/**/*.md\"",
    "docs:format": "prettier -w \"docs/**/*.md\"",
    "docs:verify": "npm run docs:lint && npm run docs:links && npm run docs:spell",
    "docs:fix": "node scripts/fix-docs.mjs"
  },
  "dependencies": {
    "@account-abstraction/contracts": "^0.8.0",
    "@coinbase/cdp-sdk": "^1.38.4",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@farcaster/quick-auth": "^0.0.8",
    "aes-js": "^4.0.0-beta.5",
    "ethers": "^6.15.0",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.12",
    "express": "^5.1.0",
    "hardhat": "^2.22.5",
    "doctoc": "^2.2.0",
    "cspell": "^9.2.2",
    "markdownlint-cli": "^0.45.0",
    "markdown-link-check": "^3.12.3",
    "prettier": "^3.3.3",
    "@cspell/dict-tr-tr": "^3.0.6"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
