###############################################
# BaseMan .env.example (Testnet-first)
# Fill placeholders in your own .env (do not commit secrets)
###############################################

## 1) Network & Hardhat (Base Sepolia)
BASE_SEPOLIA_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia
BASE_SEPOLIA_RPC_HEADERS={"Authorization":"Bearer <CDP_RPC_API_KEY>"}
# Optional (mainnet when switching later)
# BASE_MAINNET_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base-mainnet
# DEPLOYER_PRIVATE_KEY=0x<YOUR_TESTNET_DEPLOYER_PRIVATE_KEY>
# BASESCAN_API_KEY=

## 2) Registry / Chain config
REGISTRY_DEFAULT_TARGET=base-sepolia
REGISTRY_CHAIN_ID=84532
# EIP-712 domain version: set 2 for BaseManRegistryV2 (recommended)
REGISTRY_EIP712_VERSION=2
NEXT_PUBLIC_REGISTRY_ADDRESS=0x<BASE_SEPOLIA_REGISTRY_ADDRESS>
BASE_SEPOLIA_REGISTRY_ADDRESS=0x<BASE_SEPOLIA_REGISTRY_ADDRESS>
BASE_SEPOLIA_REGISTRY_CHAIN_ID=84532

## 3) Signing keys (dedicated authorizer recommended)
SCORE_SIGNER_PRIVATE_KEY=0x<DEDICATED_SCORE_SIGNER_PRIVATE_KEY>
BASE_SEPOLIA_SCORE_SIGNER_PRIVATE_KEY=0x<DEDICATED_SCORE_SIGNER_PRIVATE_KEY>
# Optional quest signer
# QUEST_SIGNER_PRIVATE_KEY=0x<YOUR_QUEST_SIGNER_PRIVATE_KEY>
ALLOWED_QUEST_IDS=1,2,3

## 3b) Quick Auth enforcement (optional)
# Global enforcement for Mini App Quick Auth on signing endpoints (score/quest)
# Set to `true` to require Quick Auth token on /api/score-sign and /api/quest-sign
REQUIRE_MINIAPP_AUTH=false
# Per-endpoint overrides (if set, they take precedence over global flag)
SCORE_REQUIRE_MINIAPP_AUTH=
QUEST_REQUIRE_MINIAPP_AUTH=

## 4) Paymaster / Bundler (CDP project)
NEXT_PUBLIC_PAYMASTER_URL=/api/paymaster-proxy
PAYMASTER_SERVICE_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/<PROJECT_ID>
PAYMASTER_API_KEY=<CDP_PAYMASTER_API_KEY>
PAYMASTER_API_KEY_HEADER=Authorization
PAYMASTER_API_KEY_SCHEME=Bearer
PAYMASTER_ENFORCE_ALLOWLIST=true
# Optional guard rails
# PAYMASTER_ALLOWED_TARGETS=
PAYMASTER_MAX_CALLS=1
# Optional function-level allowlist (comma-separated 4-byte selectors)
# PAYMASTER_ALLOWED_SELECTORS=
NEXT_PUBLIC_BUNDLER_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/<PROJECT_ID>

# Expose EIP-712 version to client logic (read-only, recommended 2 for V2)
NEXT_PUBLIC_REGISTRY_EIP712_VERSION=2

## 5) Coinbase Data (Leaderboard via SQL API)
CDP_SQL_API_KEY=<CDP_SQL_API_KEY>
CDP_SQL_API_BASE_URL=https://api.cdp.coinbase.com
# Optional alternative (the code auto-falls back if 404):
# CDP_SQL_API_BASE_URL=https://api.developer.coinbase.com
# Fallback RPC for fresh logs (headerless HTTP RPC)
ADDRESS_HISTORY_RPC_URL=https://<your-rpc-provider>/<key>
ADDRESS_HISTORY_CACHE_TTL_MS=300000
# Leaderboard RPC tuning (optional)
LEADERBOARD_FALLBACK_WINDOW_BLOCKS=50000
LEADERBOARD_FALLBACK_CHUNK_SIZE=4000
# LEADERBOARD_RPC_URL=https://<override-rpc-url>

## 6) Farcaster profile enrichment (optional)
FARCASTER_PROFILE_PROVIDER=neynar
NEYNAR_API_KEY=<NEYNAR_API_KEY>
NEYNAR_API_BASE_URL=https://api.neynar.com
LEADERBOARD_DISABLE_PROFILE_ENRICHMENT=false

## 7) Webhooks (optional)
# CDP_WEBHOOK_SECRET=<random-secret>
CDP_WEBHOOK_MAX_DRIFT_MS=300000
CDP_WEBHOOK_CACHE_TTL_MS=300000
CDP_WEBHOOK_CACHE_SIZE=200
CDP_WEBHOOK_LOG_ENDPOINT=

## 7b) Farcaster Quick Auth (optional but recommended in Mini App)
# Mode selection:
#  - jwks/local: verify JWT locally using Farcaster JWKS (no external verify URL)
#  - remote: forward token to a verification endpoint
MINIAPP_AUTH_MODE=jwks

# Local (JWKS) mode options
# Origin that issues the JWTs (defaults to https://auth.farcaster.xyz)
MINIAPP_AUTH_ORIGIN=
# Expected audience (domain). If empty, server will try to infer from Host header.
MINIAPP_AUTH_DOMAIN=

# Remote verify mode options
# Verification endpoint for Quick Auth tokens
# Example: https://miniapps.farcaster.xyz/api/verify
MINIAPP_AUTH_VERIFY_URL=
# Optional headers for verification request (JSON). Example: {"Authorization":"Bearer <YOUR_TOKEN>"}
MINIAPP_AUTH_VERIFY_HEADERS=

## 8) WalletConnect (optional, for OnchainKit wallet UI)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

## 9) Leaderboard (optional)
# Hide/show the leaderboard UI in the client
NEXT_PUBLIC_SHOW_LEADERBOARD=0
# Disable backend leaderboard calls in dev
# LEADERBOARD_DISABLE=1

###############################################
# Notes
# - Do not commit .env; only .env.example with placeholders.
# - NEXT_PUBLIC_* variables are public (visible to client). Never put secrets there.
# - For Production, avoid storing DEPLOYER_PRIVATE_KEY; use dedicated signer only.
###############################################
# Network / Registry
# Set the active deployment target
#  - REGISTRY_CHAIN_ID: 8453 (Base) or 84532 (Base Sepolia)
#  - NEXT_PUBLIC_REGISTRY_ADDRESS: Registry contract address for the active network
REGISTRY_CHAIN_ID=84532
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Optional alternate addresses per network (used by profile panel network switcher)
NEXT_PUBLIC_BASE_MAINNET_REGISTRY_ADDRESS=
BASE_SEPOLIA_REGISTRY_ADDRESS=

# Optional Bundler/Paymaster (set NEXT_PUBLIC_ variants for client-side exposure when needed)
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_PAYMASTER_URL=

# Manifest generation
# Allow Base Builder addresses (comma-separated)
BASE_BUILDER_ALLOWED_ADDRESSES=
# Force requiredChains; e.g. "eip155:8453,eip155:84532"
MANIFEST_REQUIRED_CHAINS=

# CDP API (optional but recommended for balances/history/analytics)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
