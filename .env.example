#####
# BaseMan .env.example — güvenli örnek dosya
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri lokalinizde doldurun.
# Üretimde gizli anahtarları Vercel Environment Variables üzerinden yönetin.
#####

## 1) Çekirdek ağ ve registry
REGISTRY_DEFAULT_TARGET=base-sepolia
REGISTRY_CHAIN_ID=84532
BASE_SEPOLIA_REGISTRY_CHAIN_ID=84532
REGISTRY_EIP712_VERSION=2
NEXT_PUBLIC_REGISTRY_EIP712_VERSION=2
NEXT_PUBLIC_REGISTRY_ADDRESS="0xYourSepoliaRegistry"
BASE_SEPOLIA_REGISTRY_ADDRESS="0xYourSepoliaRegistry"
NEXT_PUBLIC_BASE_MAINNET_REGISTRY_ADDRESS="0xYourMainnetRegistry"

## 2) RPC uçları (public + server)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
NEXT_PUBLIC_BASE_MAINNET_RPC_URL="https://mainnet.base.org"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
# Doküman uyumluluk takma adları
RPC_URL_BASE_SEPOLIA="https://sepolia.base.org"
RPC_URL_BASE="https://mainnet.base.org"

## 3) Paymaster / Bundler (EIP-5792)
# Public (istemci):
NEXT_PUBLIC_PAYMASTER_URL="/api/paymaster-proxy"
NEXT_PUBLIC_PAYMASTER_AND_BUNDLER_ENDPOINT="/api/paymaster-proxy"
NEXT_PUBLIC_BUNDLER_URL="https://api.developer.coinbase.com/rpc/v1/base/<PROJECT-KEY>"
# Server (proxy ve SDK’lar için):
PAYMASTER_SERVICE_URL="https://api.developer.coinbase.com/rpc/v1/base/<PROJECT-KEY>"
PAYMASTER_ALLOWED_TARGETS="0xYourRegistryAddress"
PAYMASTER_ALLOWED_SELECTORS="0x42a252f6,0xa12020e8"
PAYMASTER_ENFORCE_ALLOWLIST=true
PAYMASTER_MAX_CALLS=1
# (Opsiyonel) CDP kimlik bilgileri — üretimde Vercel env’de tutun
CDP_API_KEY_ID=""
CDP_API_KEY_SECRET=""
CDP_API_KEY=""
CDP_PAYMASTER_URL="https://api.developer.coinbase.com/rpc/v1/base/<PROJECT-KEY>"
CDP_BUNDLER_URL="https://api.developer.coinbase.com/rpc/v1/base/<PROJECT-KEY>"

## 4) İmzalayıcı anahtarları (backend) — boş bırakın, lokalinizde doldurun
SCORE_SIGNER_PRIVATE_KEY=""
BASE_SEPOLIA_SCORE_SIGNER_PRIVATE_KEY=""
QUEST_SIGNER_PRIVATE_KEY=""
BASE_SEPOLIA_QUEST_SIGNER_PRIVATE_KEY=""
DEPLOYER_PRIVATE_KEY=""
# Doküman uyumluluk (örnekler için):
PRIVATE_KEY=""

## 5) İstemci anahtarları (public)
NEXT_PUBLIC_CDP_API_KEY=""
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Alternatif isim (opsiyonel):
NEXT_PUBLIC_WC_PROJECT_ID=""

## 6) Diğer ayarlar
ALLOWED_QUEST_IDS="1,2,3"
BASESCAN_API_KEY=""
CDP_SQL_API_KEY=""
BASE_BUILDER_ALLOWED_ADDRESSES="0xYourEOA,0xYourRegistryAddress"
MANIFEST_REQUIRED_CHAINS="eip155:8453,eip155:84532"
# Logging levels: debug, info, warn, error
# Dev default: debug, Production default: warn
BASEMAN_LOG_LEVEL=warn

## 7) Farcaster Mini App Quick Auth
MINIAPP_AUTH_MODE=jwks
MINIAPP_AUTH_ORIGIN="https://auth.farcaster.xyz"
MINIAPP_AUTH_DOMAIN="your-app-domain.vercel.app"
MINIAPP_AUTH_VERIFY_URL=
MINIAPP_AUTH_VERIFY_HEADERS=
REQUIRE_MINIAPP_AUTH=false
SCORE_REQUIRE_MINIAPP_AUTH=false
QUEST_REQUIRE_MINIAPP_AUTH=false

#####
# Notlar
# - Bu dosyayı .env olarak kopyalayın: cp BaseMan/.env.example BaseMan/.env
# - On‑chain config üretimi: npm run onchain:config
# - Üretimde .env’yi repoya göndermeyin; Vercel env kullanın.
#####

# Telegram Error Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
