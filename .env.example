###############################################
# BaseMan .env.example (Testnet-first)
# Fill placeholders in your own .env (do not commit secrets)
###############################################

## 1) Network & Hardhat (Base Sepolia)
BASE_SEPOLIA_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia
BASE_SEPOLIA_RPC_HEADERS={"Authorization":"Bearer <CDP_RPC_API_KEY>"}
# Optional (mainnet when switching later)
# BASE_MAINNET_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base-mainnet
# DEPLOYER_PRIVATE_KEY=0x<YOUR_TESTNET_DEPLOYER_PRIVATE_KEY>
# BASESCAN_API_KEY=

## 2) Registry / Chain config
REGISTRY_DEFAULT_TARGET=base-sepolia
REGISTRY_CHAIN_ID=84532
NEXT_PUBLIC_REGISTRY_ADDRESS=0x<BASE_SEPOLIA_REGISTRY_ADDRESS>
BASE_SEPOLIA_REGISTRY_ADDRESS=0x<BASE_SEPOLIA_REGISTRY_ADDRESS>
BASE_SEPOLIA_REGISTRY_CHAIN_ID=84532

## 3) Signing keys (dedicated authorizer recommended)
SCORE_SIGNER_PRIVATE_KEY=0x<DEDICATED_SCORE_SIGNER_PRIVATE_KEY>
BASE_SEPOLIA_SCORE_SIGNER_PRIVATE_KEY=0x<DEDICATED_SCORE_SIGNER_PRIVATE_KEY>
# Optional quest signer
# QUEST_SIGNER_PRIVATE_KEY=0x<YOUR_QUEST_SIGNER_PRIVATE_KEY>
ALLOWED_QUEST_IDS=1,2,3

## 4) Paymaster / Bundler (CDP project)
NEXT_PUBLIC_PAYMASTER_URL=/api/paymaster-proxy
PAYMASTER_SERVICE_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/<PROJECT_ID>
PAYMASTER_API_KEY=<CDP_PAYMASTER_API_KEY>
PAYMASTER_API_KEY_HEADER=Authorization
PAYMASTER_API_KEY_SCHEME=Bearer
PAYMASTER_ENFORCE_ALLOWLIST=true
# Optional guard rails
# PAYMASTER_ALLOWED_TARGETS=
PAYMASTER_MAX_CALLS=1
NEXT_PUBLIC_BUNDLER_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/<PROJECT_ID>

## 5) Coinbase Data (Leaderboard via SQL API)
CDP_SQL_API_KEY=<CDP_SQL_API_KEY>
CDP_SQL_API_BASE_URL=https://api.cdp.coinbase.com
# Fallback RPC for fresh logs (headerless HTTP RPC)
ADDRESS_HISTORY_RPC_URL=https://<your-rpc-provider>/<key>
ADDRESS_HISTORY_CACHE_TTL_MS=300000
# Leaderboard RPC tuning (optional)
LEADERBOARD_FALLBACK_WINDOW_BLOCKS=50000
LEADERBOARD_FALLBACK_CHUNK_SIZE=4000
# LEADERBOARD_RPC_URL=https://<override-rpc-url>

## 6) Farcaster profile enrichment (optional)
FARCASTER_PROFILE_PROVIDER=neynar
NEYNAR_API_KEY=<NEYNAR_API_KEY>
NEYNAR_API_BASE_URL=https://api.neynar.com

## 7) Webhooks (optional)
# CDP_WEBHOOK_SECRET=<random-secret>
CDP_WEBHOOK_MAX_DRIFT_MS=300000
CDP_WEBHOOK_CACHE_TTL_MS=300000
CDP_WEBHOOK_CACHE_SIZE=200
CDP_WEBHOOK_LOG_ENDPOINT=

###############################################
# Notes
# - Do not commit .env; only .env.example with placeholders.
# - NEXT_PUBLIC_* variables are public (visible to client). Never put secrets there.
# - For Production, avoid storing DEPLOYER_PRIVATE_KEY; use dedicated signer only.
###############################################
