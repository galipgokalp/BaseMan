## Hardhat deployment
BASE_SEPOLIA_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia
BASE_SEPOLIA_RPC_HEADERS={"Authorization":"Bearer <client-api-key>"}
BASE_MAINNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=
INITIAL_AUTHORIZER=

## Registry configuration
REGISTRY_DEFAULT_TARGET=base-sepolia
NEXT_PUBLIC_REGISTRY_ADDRESS=
REGISTRY_CHAIN_ID=84532
BASE_SEPOLIA_REGISTRY_ADDRESS=
BASE_SEPOLIA_REGISTRY_CHAIN_ID=84532
SCORE_SIGNER_PRIVATE_KEY=
QUEST_SIGNER_PRIVATE_KEY=
BASE_SEPOLIA_SCORE_SIGNER_PRIVATE_KEY=
BASE_SEPOLIA_QUEST_SIGNER_PRIVATE_KEY=
APPCHAIN_REGISTRY_ADDRESS=
APPCHAIN_REGISTRY_CHAIN_ID=
APPCHAIN_SCORE_SIGNER_PRIVATE_KEY=
APPCHAIN_QUEST_SIGNER_PRIVATE_KEY=
ALLOWED_QUEST_IDS=1,2,3

## Paymaster / backend integration
NEXT_PUBLIC_PAYMASTER_URL=/api/paymaster-proxy
PAYMASTER_SERVICE_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/<project-id>
PAYMASTER_API_KEY=
PAYMASTER_API_KEY_HEADER=Authorization
PAYMASTER_API_KEY_SCHEME=Bearer
PAYMASTER_ALLOWED_TARGETS=
PAYMASTER_MAX_CALLS=1
PAYMASTER_ENFORCE_ALLOWLIST=true
NEXT_PUBLIC_BUNDLER_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/<project-id>

## Coinbase Data APIs
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_DEFAULT_NETWORK=base-sepolia
CDP_WEBHOOK_SECRET=
CDP_WEBHOOK_MAX_DRIFT_MS=300000
CDP_WEBHOOK_CACHE_TTL_MS=300000
CDP_WEBHOOK_CACHE_SIZE=200
CDP_WEBHOOK_LOG_ENDPOINT=
ADDRESS_HISTORY_RPC_URL=
CDP_ADDRESS_HISTORY_BASE_URL=
CDP_ADDRESS_HISTORY_API_KEY=
ADDRESS_HISTORY_CACHE_TTL_MS=300000
CDP_SQL_API_KEY=
CDP_SQL_API_BASE_URL=
CDP_SQL_CONNECTION_STRING=
CDP_SQL_QUERY_TIMEOUT_MS=15000

## Farcaster profile enrichment
FARCASTER_PROFILE_PROVIDER=neynar
NEYNAR_API_KEY=
NEYNAR_API_BASE_URL=https://api.neynar.com

## Analytics automation
BASEMAN_ANALYTICS_TRACE_ENABLED=true
BASEMAN_ANALYTICS_TRACE_NETWORK=base-sepolia
BASEMAN_ANALYTICS_TRACE_WINDOW_BLOCKS=50000
BASEMAN_ANALYTICS_TRACE_OUTPUT_DIR=artifacts/trace-reports
