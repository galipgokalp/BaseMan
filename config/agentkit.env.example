# AgentKit integration example for BaseMan
# Copy this file to `.env.agentkit` (ignored by git) and populate with your keys.

# Coinbase Developer Platform secret API key credentials
CDP_API_KEY_ID=""
CDP_API_KEY_SECRET=""
CDP_DEFAULT_NETWORK="base-sepolia"
CDP_WEBHOOK_SECRET=""
CDP_WEBHOOK_MAX_DRIFT_MS="300000"
CDP_WEBHOOK_CACHE_TTL_MS="300000"
CDP_WEBHOOK_CACHE_SIZE="200"
CDP_ADDRESS_HISTORY_BASE_URL=""
CDP_ADDRESS_HISTORY_API_KEY=""
ADDRESS_HISTORY_CACHE_TTL_MS="300000"

# LLM provider keys used by AgentKit action handlers (OpenAI recommended by quickstart)
OPENAI_API_KEY=""

# Optional: override default network/contract metadata used by AgentKit actions
BASEMAN_AGENT_DEFAULT_CHAIN="base-sepolia"
BASEMAN_AGENT_BASE_REGISTRY_ADDRESS=""
BASEMAN_AGENT_BASE_RPC_URL=""
BASEMAN_AGENT_BASE_RPC_HEADERS=""
BASEMAN_AGENT_BASE_SEPOLIA_REGISTRY_ADDRESS=""
BASEMAN_AGENT_BASE_SEPOLIA_RPC_URL="https://api.developer.coinbase.com/rpc/v1/base-sepolia"
BASEMAN_AGENT_BASE_SEPOLIA_RPC_HEADERS="{\"Authorization\":\"Bearer <client-api-key>\"}"
BASEMAN_AGENT_APPCHAIN_REGISTRY_ADDRESS=""
BASEMAN_AGENT_APPCHAIN_RPC_URL=""
BASEMAN_AGENT_APPCHAIN_RPC_HEADERS=""
# Genel geri dönüş değerleri (üstteki boşsa kullanılır)
BASEMAN_AGENT_REGISTRY_ADDRESS=""
BASEMAN_AGENT_RPC_URL=""
BASEMAN_AGENT_RPC_HEADERS=""
BASEMAN_AGENT_PAYMASTER_ADDRESS=""
PAYMASTER_SERVICE_URL="https://api.developer.coinbase.com/rpc/v1/base-sepolia/<project-id>"
PAYMASTER_API_KEY=""
PAYMASTER_API_KEY_SECRET=""
PAYMASTER_API_KEY_HEADER="Authorization"
PAYMASTER_API_KEY_SCHEME="Bearer"
CDP_SQL_API_KEY=""
CDP_SQL_API_BASE_URL=""
CDP_SQL_CONNECTION_STRING=""
CDP_SQL_QUERY_TIMEOUT_MS="15000"

# Farcaster profile enrichment
FARCASTER_PROFILE_PROVIDER="neynar"
NEYNAR_API_KEY=""
NEYNAR_API_BASE_URL="https://api.neynar.com"
BASEMAN_ANALYTICS_TRACE_ENABLED="true"
BASEMAN_ANALYTICS_TRACE_NETWORK="base-sepolia"
BASEMAN_ANALYTICS_TRACE_WINDOW_BLOCKS="50000"
BASEMAN_ANALYTICS_TRACE_OUTPUT_DIR="artifacts/trace-reports"

# Optional: forwarded Farcaster signer information when delegating quests/scores through an agent
FARCASTER_FID=""
FARCASTER_SIGNER_UUID=""

# Placeholder for Server Wallet policy alignment (to be used with AgentKit Server Wallet provider)
BASEMAN_AGENT_SERVER_WALLET_POLICY_ID=""
